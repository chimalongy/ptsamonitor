@{
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "Users";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(32px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .fade-up { opacity: 0; animation: fadeUp 0.45s ease forwards; }
    .fade-up-1 { animation-delay: 0.05s; }
    .fade-up-2 { animation-delay: 0.15s; }

    #userModal, #confirmModal {
        display: none;
        animation: fadeIn 0.2s ease forwards;
    }
    #userModal.open, #confirmModal.open { display: flex; }
    #modalBox, #confirmBox {
        animation: slideUp 0.28s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
    }

    .user-row { transition: background 0.15s ease; }
    .user-row:hover { background: var(--color-surface, #f8fafc); }

    .badge-enabled  { background: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; }
    .badge-disabled { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    .spinner { animation: spin 0.7s linear infinite; }

    /* ── View User Modal ── */
    #viewModal {
        display: none;
        animation: fadeIn 0.2s ease forwards;
    }
    #viewModal.open { display: flex; }
    #viewModalBox {
        animation: slideUp 0.28s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
    }

    .view-hero {
        background: var(--color-surface, #f8fafc);
        border-bottom: 1px solid var(--color-border, #e5e7eb);
        padding: 20px 20px 16px;
    }

    .view-avatar {
        width: 52px; height: 52px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; font-weight: 500;
        flex-shrink: 0;
        background: #ede9fe;
        color: #6d28d9;
        border: 1px solid #ddd6fe;
    }

    .view-section-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 10px;
    }

    .view-field-label {
        font-size: 11px;
        color: var(--color-text-muted);
        margin-bottom: 3px;
    }

    .view-field-value       { font-size: 13px; color: var(--color-text-primary); }
    .view-field-value.empty { color: var(--color-text-muted); font-style: italic; }

    .view-pill-list { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }

    .view-pill {
        font-size: 11px;
        padding: 2px 9px;
        border-radius: 20px;
        background: var(--color-surface, #f1f5f9);
        border: 1px solid var(--color-border, #e2e8f0);
        color: var(--color-text-secondary);
    }

    .view-pill-brand {
        font-size: 11px;
        padding: 2px 9px;
        border-radius: 20px;
        background: #ede9fe;
        border: 1px solid #ddd6fe;
        color: #6d28d9;
    }

    .view-timestamps {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 12px 14px;
        background: var(--color-surface, #f8fafc);
        border-radius: 12px;
        border: 1px solid var(--color-border, #e5e7eb);
    }

    .view-ts-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 2px;
    }

    .view-ts-value { font-size: 12px; color: var(--color-text-secondary); }

    .view-divider {
        height: 1px;
        background: var(--color-border, #e5e7eb);
    }
</style>

@* ── Page header ── *@
<div class="flex items-center justify-between mb-6 fade-up fade-up-1">
    <div>
        <h1 class="text-text-primary text-2xl font-semibold font-display">Users</h1>
        <p class="text-text-muted text-sm mt-0.5">Manage system users and their access privileges.</p>
    </div>
    <button onclick="openAddModal()"
            class="flex items-center gap-2 px-4 py-2.5 bg-accent-500 hover:bg-accent-600
                   text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14"/>
        </svg>
        Add User
    </button>
</div>

@* ── Alert area ── *@
<div id="alertArea" class="hidden mb-4"></div>

@* ── Users table card ── *@
<div class="bg-surface-card border border-border rounded-2xl shadow-sm overflow-hidden fade-up fade-up-2">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border bg-surface">
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Username</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide hidden md:table-cell">Email</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Institution</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide hidden sm:table-cell">Type</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide hidden lg:table-cell">Privileges</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Status</th>
                    <th class="text-right text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                <tr>
                    <td colspan="7" class="text-center py-12 text-text-muted">
                        <svg class="w-5 h-5 mx-auto mb-2 spinner text-brand-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                        <span class="text-xs">Loading users...</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* Footer count *@
    <div class="px-5 py-3 border-t border-border bg-surface flex items-center justify-between">
        <span id="userCount" class="text-xs text-text-muted">--</span>
        <span class="text-xs text-text-muted">PTSA Monitor - Users</span>
    </div>
</div>

@* ══════════════ VIEW USER MODAL ══════════════ *@
<div id="viewModal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4">
    <div id="viewModalBox"
         class="bg-surface-card border border-border rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">

        @* Hero — close button sits in the flex row, not absolute *@
        <div class="view-hero">
            <div class="flex items-start gap-3.5">
                <div id="viewAvatarWrap" class="flex-shrink-0"></div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p id="viewUserName" class="text-text-primary font-semibold text-base leading-snug mb-0.5"></p>
                    <p id="viewEmail" class="text-text-muted text-xs mb-2.5"></p>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span id="viewTypeBadge" class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full"></span>
                        <span id="viewStatusBadge" class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full"></span>
                    </div>
                </div>
                <button onclick="closeViewModal()"
                        class="flex-shrink-0 w-7 h-7 flex items-center justify-center
                               rounded-lg bg-surface-card border border-border
                               text-text-muted hover:text-text-primary transition-colors mt-0.5">
                    <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="w-3 h-3">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        @* Body *@
        <div class="px-6 py-5 space-y-5">

            @* Identity *@
            <div>
                <p class="view-section-label">Identity</p>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="view-field-label">Institution</p>
                        <p id="viewInstitution" class="view-field-value"></p>
                    </div>
                    <div>
                        <p class="view-field-label">User type</p>
                        <p id="viewUserType" class="view-field-value"></p>
                    </div>
                </div>
            </div>

            <div class="view-divider"></div>

            @* Privileges *@
            <div>
                <p class="view-section-label">Privileges</p>
                <div id="viewPrivileges" class="view-pill-list"></div>
            </div>

            <div class="view-divider"></div>

            @* Activity *@
            <div>
                <p class="view-section-label">Activity</p>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="view-field-label">Last login</p>
                        <p id="viewLastLogin" class="view-field-value"></p>
                    </div>
                    <div>
                        <p class="view-field-label">Account status</p>
                        <p id="viewStatusText" class="view-field-value"></p>
                    </div>
                </div>
            </div>

            @* Timestamps *@
            <div class="view-timestamps">
                <div>
                    <p class="view-ts-label">Created</p>
                    <p id="viewCreatedAt" class="view-ts-value"></p>
                </div>
                <div>
                    <p class="view-ts-label">Last updated</p>
                    <p id="viewUpdatedAt" class="view-ts-value"></p>
                </div>
            </div>

        </div>

        @* Footer *@
        <div class="px-6 py-4 border-t border-border flex justify-end gap-2.5">
            <button onclick="closeViewModal()"
                    class="px-4 py-2 text-sm text-text-secondary hover:text-text-primary
                           border border-border rounded-xl transition-colors">
                Close
            </button>
            <button id="viewEditBtn"
                    class="flex items-center gap-2 px-5 py-2 bg-accent-500 hover:bg-accent-600
                           text-white text-sm font-medium rounded-xl transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Edit User
            </button>
        </div>

    </div>
</div>

@* ══════════════ ADD/EDIT USER MODAL ══════════════ *@
<div id="userModal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4">
    <div id="modalBox"
         class="bg-surface-card border border-border rounded-2xl shadow-xl w-full max-w-md">

        @* Modal header *@
        <div class="flex items-center justify-between px-6 py-4 border-b border-border">
            <h2 id="modalTitle" class="text-text-primary font-semibold text-base">Add New User</h2>
            <button onclick="closeAddModal()"
                    class="w-7 h-7 flex items-center justify-center rounded-lg
                           text-text-muted hover:text-text-primary hover:bg-surface transition-colors">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="w-4 h-4">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>

        @* Modal body *@
        <div class="px-6 py-5 space-y-4">
            <div id="modalAlert" class="hidden"></div>

            <input type="hidden" id="editUserId" value="" />

            <div>
                <label class="text-xs font-medium text-text-secondary block mb-1">Username *</label>
                <input id="newUserName" type="text" placeholder="johndoe"
                       class="w-full px-3 py-2.5 bg-surface border border-border rounded-xl text-sm
                              text-text-primary placeholder-text-muted focus:outline-none
                              focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-colors" />
            </div>

            <div>
                <label class="text-xs font-medium text-text-secondary block mb-1">Email Address</label>
                <input id="newEmail" type="email" placeholder="john.doe@company.com"
                       class="w-full px-3 py-2.5 bg-surface border border-border rounded-xl text-sm
                              text-text-primary placeholder-text-muted focus:outline-none
                              focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-colors" />
            </div>

            <div>
                <label class="text-xs font-medium text-text-secondary block mb-1">Institution</label>
                <select id="newInstitution"
                        class="w-full px-3 py-2.5 bg-surface border border-border rounded-xl text-sm
                               text-text-primary focus:outline-none focus:border-brand-400
                               focus:ring-2 focus:ring-brand-100 transition-colors">
                    <option value="">-- Select Institution --</option>
                </select>
            </div>

            <div>
                <label class="text-xs font-medium text-text-secondary block mb-1">User Type</label>
                <select id="newUserType"
                        class="w-full px-3 py-2.5 bg-surface border border-border rounded-xl text-sm
                               text-text-primary focus:outline-none focus:border-brand-400
                               focus:ring-2 focus:ring-brand-100 transition-colors">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div>
                <label class="text-xs font-medium text-text-secondary block mb-1">Privileges</label>
                <div class="space-y-2 bg-surface rounded-xl px-3 py-3 border border-border">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="privSpooling" value="transaction spooling"
                               class="w-4 h-4 rounded border-border text-brand-500 focus:ring-brand-500" />
                        <span class="text-sm text-text-secondary">Transaction Spooling</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="privModerator" value="transaction moderator"
                               class="w-4 h-4 rounded border-border text-brand-500 focus:ring-brand-500" />
                        <span class="text-sm text-text-secondary">Transaction Moderator</span>
                    </label>
                </div>
            </div>

            <div class="flex items-center gap-2 bg-surface rounded-xl px-3 py-2.5 border border-border">
                <svg class="w-4 h-4 text-text-muted flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span class="text-xs text-text-muted">Password will be set from the system default.</span>
            </div>
        </div>

        @* Modal footer *@
        <div class="px-6 py-4 border-t border-border flex justify-end gap-3">
            <button onclick="closeAddModal()"
                    class="px-4 py-2 text-sm text-text-secondary hover:text-text-primary
                           border border-border rounded-xl transition-colors">
                Cancel
            </button>
            <button id="saveUserBtn" onclick="saveUser()"
                    class="px-5 py-2 bg-accent-500 hover:bg-accent-600 text-white
                           text-sm font-medium rounded-xl transition-colors flex items-center gap-2">
                <span id="saveBtnText">Create User</span>
                <svg id="saveBtnSpinner" class="hidden w-4 h-4 spinner" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
            </button>
        </div>
    </div>
</div>

@* ══════════════ CONFIRM MODAL ══════════════ *@
<div id="confirmModal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4">
    <div id="confirmBox"
         class="bg-surface-card border border-border rounded-2xl shadow-xl w-full max-w-sm px-6 py-6">
        <div id="confirmIcon" class="w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-4"></div>
        <h3 id="confirmTitle" class="text-text-primary font-semibold text-base text-center mb-1"></h3>
        <p id="confirmMessage" class="text-text-muted text-sm text-center mb-5"></p>
        <div class="flex gap-3">
            <button onclick="closeConfirm()"
                    class="flex-1 py-2 text-sm text-text-secondary border border-border rounded-xl hover:bg-surface transition-colors">
                Cancel
            </button>
            <button id="confirmActionBtn"
                    class="flex-1 py-2 text-sm font-medium text-white rounded-xl transition-colors">
                Confirm
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allUsers = [];
    let allInstitutions = [];
    let pendingAction = null;
    let isEditing = false;

    // ── Load users and institutions on page load ────────────────────────────
    async function loadData() {
        try {
            const [userRes, instRes] = await Promise.all([
                fetch('/Dashboard/Users/GetAll'),
                fetch('/Dashboard/Institutions/GetAll')
            ]);

            if (!userRes.ok) throw new Error('Failed to fetch users');
            allUsers = await userRes.json();
            allInstitutions = instRes.ok ? await instRes.json() : [];

            populateInstitutionDropdown();
            renderTable(allUsers);
        } catch (err) {
            document.getElementById('usersTableBody').innerHTML = `
                <tr>
                    <td colspan="7" class="text-center py-12 text-text-muted text-xs">
                        Failed to load users. Please refresh the page.
                    </td>
                </tr>`;
        }
    }

    function populateInstitutionDropdown() {
        const select = document.getElementById('newInstitution');
        select.innerHTML = '<option value="">-- Select Institution --</option>' +
            allInstitutions.map(inst =>
                `<option value="${escHtml(inst.institutionName)}">${escHtml(inst.institutionName)}</option>`
            ).join('');
    }

    // ── Render table ────────────────────────────────────────────────────────
    function renderTable(users) {
        const tbody = document.getElementById('usersTableBody');
        const countEl = document.getElementById('userCount');

        countEl.textContent = `${users.length} user${users.length !== 1 ? 's' : ''} total`;

        if (users.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center py-12 text-text-muted text-xs">
                        No users found. Add one to get started.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = users.map(u => {
            const isDisabled = (u.status || '').toLowerCase() === 'disabled';
            const privs = u.privileges
                ? u.privileges.split(',').map(p => `<span class="text-[10px] bg-brand-50 text-brand-600 px-1.5 py-0.5 rounded-full">${escHtml(p.trim())}</span>`).join(' ')
                : '<span class="text-[10px] text-text-muted">None</span>';

            return `
            <tr class="user-row border-b border-border last:border-0" id="row-${u.id}">
                <td class="px-5 py-3.5">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-full bg-brand-50 border border-brand-100
                                    flex items-center justify-center flex-shrink-0">
                            <span class="text-xs font-semibold text-brand-600">
                                ${(u.userName || '?')[0].toUpperCase()}
                            </span>
                        </div>
                        <span class="text-text-primary font-medium">${escHtml(u.userName || '--')}</span>
                    </div>
                </td>
                <td class="px-5 py-3.5 text-text-secondary text-xs hidden md:table-cell">${escHtml(u.email || '--')}</td>
                <td class="px-5 py-3.5 text-text-secondary text-xs">${escHtml(u.institution || '--')}</td>
                <td class="px-5 py-3.5 hidden sm:table-cell">
                    <span class="text-xs px-2 py-0.5 rounded-full border
                        ${u.userType === 'Admin'
                            ? 'bg-brand-50 text-brand-600 border-brand-100'
                            : 'bg-surface text-text-muted border-border'}">
                        ${escHtml(u.userType || 'User')}
                    </span>
                </td>
                <td class="px-5 py-3.5 hidden lg:table-cell">${privs}</td>
                <td class="px-5 py-3.5">
                    <span class="text-xs px-2.5 py-0.5 rounded-full font-medium
                        ${isDisabled ? 'badge-disabled' : 'badge-enabled'}">
                        ${isDisabled ? 'Disabled' : 'Enabled'}
                    </span>
                </td>
                <td class="px-5 py-3.5 text-right">
                    <div class="flex items-center justify-end gap-2">
                        <button onclick="openViewModal(${u.id})"
                                title="View user"
                                class="text-xs px-3 py-1.5 rounded-lg border border-border
                                       text-text-secondary hover:bg-surface transition-colors">
                            View
                        </button>
                        <button onclick="openEditModal(${u.id})"
                                title="Edit user"
                                class="text-xs px-3 py-1.5 rounded-lg border border-brand-200
                                       text-brand-600 hover:bg-brand-50 transition-colors">
                            Edit
                        </button>
                        <button onclick="confirmDisable(${u.id}, ${isDisabled})"
                                title="${isDisabled ? 'Enable' : 'Disable'} user"
                                class="text-xs px-3 py-1.5 rounded-lg border transition-colors
                                    ${isDisabled
                                        ? 'border-brand-200 text-brand-600 hover:bg-brand-50'
                                        : 'border-border text-text-secondary hover:border-amber-300 hover:text-amber-600 hover:bg-amber-50'}">
                            ${isDisabled ? 'Enable' : 'Disable'}
                        </button>
                        <button onclick="confirmDelete(${u.id}, '${escHtml(u.userName)}')"
                                title="Delete user"
                                class="text-xs px-3 py-1.5 rounded-lg border border-border
                                       text-text-secondary hover:border-red-300 hover:text-red-600
                                       hover:bg-red-50 transition-colors">
                            Delete
                        </button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

    // ── Escape HTML helper ──────────────────────────────────────────────────
    function escHtml(str) {
        return String(str || '')
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── View Modal ──────────────────────────────────────────────────────────
    function openViewModal(id) {
        const u = allUsers.find(u => u.id === id);
        if (!u) return;

        const isDisabled = (u.status || '').toLowerCase() === 'disabled';
        const isAdmin    = (u.userType || '').toLowerCase() === 'admin';

        // Avatar
        document.getElementById('viewAvatarWrap').innerHTML = `
            <div class="view-avatar">
                ${(u.userName || '?')[0].toUpperCase()}
            </div>`;

        // Name & email
        document.getElementById('viewUserName').textContent = u.userName || '--';
        const emailEl = document.getElementById('viewEmail');
        emailEl.textContent = u.email || '';

        // Type badge
        const typeBadge = document.getElementById('viewTypeBadge');
        typeBadge.textContent = u.userType || 'User';
        typeBadge.className = `inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full
            ${isAdmin
                ? 'bg-brand-50 text-brand-600 border border-brand-100'
                : 'bg-surface text-text-muted border border-border'}`;

        // Status badge
        const statusBadge = document.getElementById('viewStatusBadge');
        statusBadge.textContent = isDisabled ? 'Disabled' : 'Enabled';
        statusBadge.className = `inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full
            ${isDisabled ? 'badge-disabled' : 'badge-enabled'}`;

        // Identity fields
        const instEl = document.getElementById('viewInstitution');
        instEl.textContent  = u.institution || '—';
        instEl.className    = u.institution ? 'view-field-value' : 'view-field-value empty';

        document.getElementById('viewUserType').textContent = u.userType || 'User';

        // Privileges
        const privsContainer = document.getElementById('viewPrivileges');
        if (u.privileges && u.privileges.trim()) {
            const items = u.privileges.split(',').map(p => p.trim()).filter(Boolean);
            privsContainer.innerHTML = items.map(p =>
                `<span class="view-pill-brand">${escHtml(p)}</span>`
            ).join('');
        } else {
            privsContainer.innerHTML = `<span class="view-field-value empty text-xs">No privileges assigned</span>`;
        }

        // Activity
        const fmt = d => d
            ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
            : '—';
        const fmtFull = d => d
            ? new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
            : 'Never';

        const lastLoginEl = document.getElementById('viewLastLogin');
        lastLoginEl.textContent = fmtFull(u.lastLoginDate);
        lastLoginEl.className   = u.lastLoginDate ? 'view-field-value' : 'view-field-value empty';

        const statusTextEl = document.getElementById('viewStatusText');
        statusTextEl.textContent = isDisabled ? 'Disabled' : 'Active';
        statusTextEl.className   = `view-field-value ${isDisabled ? 'text-red-500' : 'text-green-600'}`;

        // Timestamps
        document.getElementById('viewCreatedAt').textContent = fmt(u.createdAt);
        document.getElementById('viewUpdatedAt').textContent = fmt(u.updatedAt);

        // Edit shortcut
        document.getElementById('viewEditBtn').onclick = () => {
            closeViewModal();
            openEditModal(id);
        };

        document.getElementById('viewModal').classList.add('open');
    }

    function closeViewModal() {
        document.getElementById('viewModal').classList.remove('open');
    }

    document.getElementById('viewModal').addEventListener('click', function (e) {
        if (e.target === this) closeViewModal();
    });

    // ── Confirm modal helpers ───────────────────────────────────────────────
    function openConfirm({ icon, iconBg, title, message, btnColor, action }) {
        document.getElementById('confirmIcon').className =
            `w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-4 ${iconBg}`;
        document.getElementById('confirmIcon').innerHTML = icon;
        document.getElementById('confirmTitle').textContent = title;
        document.getElementById('confirmMessage').textContent = message;

        const btn = document.getElementById('confirmActionBtn');
        btn.className = `flex-1 py-2 text-sm font-medium text-white rounded-xl transition-colors ${btnColor}`;
        pendingAction = action;
        btn.onclick = () => { pendingAction(); };

        document.getElementById('confirmModal').classList.add('open');
    }

    function closeConfirm() {
        document.getElementById('confirmModal').classList.remove('open');
        pendingAction = null;
    }

    // ── Delete ──────────────────────────────────────────────────────────────
    function confirmDelete(userId, name) {
        openConfirm({
            icon: `<svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                       <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                       <path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                   </svg>`,
            iconBg: 'bg-red-50',
            title: 'Delete User',
            message: `Are you sure you want to permanently delete ${name}? This action cannot be undone.`,
            btnColor: 'bg-red-500 hover:bg-red-600',
            action: () => deleteUser(userId)
        });
    }

    async function deleteUser(userId) {
        closeConfirm();
        try {
            const res = await fetch(`/Dashboard/Users/Delete/${userId}`, { method: 'POST' });
            if (!res.ok) throw new Error();
            document.getElementById(`row-${userId}`)?.remove();
            allUsers = allUsers.filter(u => u.id !== userId);
            document.getElementById('userCount').textContent =
                `${allUsers.length} user${allUsers.length !== 1 ? 's' : ''} total`;
            showAlert('User deleted successfully.', 'success');
        } catch {
            showAlert('Failed to delete user. Please try again.', 'error');
        }
    }

    // ── Disable / Enable ────────────────────────────────────────────────────
    function confirmDisable(userId, isCurrentlyDisabled) {
        const action = isCurrentlyDisabled ? 'enable' : 'disable';
        const user = allUsers.find(u => u.id === userId);
        const name = user ? user.userName : 'this user';

        openConfirm({
            icon: `<svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                       <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
                       <line x1="12" y1="16" x2="12.01" y2="16"/>
                   </svg>`,
            iconBg: 'bg-amber-50',
            title: `${isCurrentlyDisabled ? 'Enable' : 'Disable'} User`,
            message: `Are you sure you want to ${action} ${name}?`,
            btnColor: 'bg-amber-500 hover:bg-amber-600',
            action: () => toggleDisable(userId, isCurrentlyDisabled)
        });
    }

    async function toggleDisable(userId, isCurrentlyDisabled) {
        closeConfirm();
        const newStatus = isCurrentlyDisabled ? 'enabled' : 'disabled';
        try {
            const res = await fetch(`/Dashboard/Users/UpdateStatus/${userId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            if (!res.ok) throw new Error();
            const user = allUsers.find(u => u.id === userId);
            if (user) user.status = newStatus;
            renderTable(allUsers);
            showAlert(`User ${newStatus} successfully.`, 'success');
        } catch {
            showAlert('Failed to update user status. Please try again.', 'error');
        }
    }

    // ── Add/Edit User Modal ─────────────────────────────────────────────────
    function openAddModal() {
        isEditing = false;
        document.getElementById('modalTitle').textContent = 'Add New User';
        document.getElementById('saveBtnText').textContent = 'Create User';
        document.getElementById('editUserId').value = '';
        document.getElementById('newUserName').value = '';
        document.getElementById('newEmail').value = '';
        document.getElementById('newInstitution').value = '';
        document.getElementById('newUserType').value = 'User';
        document.getElementById('privSpooling').checked = false;
        document.getElementById('privModerator').checked = false;
        document.getElementById('newUserName').disabled = false;
        document.getElementById('modalAlert').classList.add('hidden');
        document.getElementById('userModal').classList.add('open');
        document.getElementById('newUserName').focus();
    }

    function openEditModal(userId) {
        const user = allUsers.find(u => u.id === userId);
        if (!user) return;

        isEditing = true;
        document.getElementById('modalTitle').textContent = 'Edit User';
        document.getElementById('saveBtnText').textContent = 'Save Changes';
        document.getElementById('editUserId').value = user.id;
        document.getElementById('newUserName').value = user.userName || '';
        document.getElementById('newUserName').disabled = true;
        document.getElementById('newEmail').value = user.email || '';
        document.getElementById('newInstitution').value = user.institution || '';
        document.getElementById('newUserType').value = user.userType || 'User';

        const privs = (user.privileges || '').toLowerCase();
        document.getElementById('privSpooling').checked = privs.includes('transaction spooling');
        document.getElementById('privModerator').checked = privs.includes('transaction moderator');

        document.getElementById('modalAlert').classList.add('hidden');
        document.getElementById('userModal').classList.add('open');
    }

    function closeAddModal() {
        document.getElementById('userModal').classList.remove('open');
    }

    function getSelectedPrivileges() {
        const privs = [];
        if (document.getElementById('privSpooling').checked) privs.push('transaction spooling');
        if (document.getElementById('privModerator').checked) privs.push('transaction moderator');
        return privs.join(',');
    }

    async function saveUser() {
        const id = document.getElementById('editUserId').value;
        const userName = document.getElementById('newUserName').value.trim();
        const email = document.getElementById('newEmail').value.trim();
        const institution = document.getElementById('newInstitution').value;
        const userType = document.getElementById('newUserType').value;
        const privileges = getSelectedPrivileges();

        if (!userName) {
            showModalAlert('Username is required.', 'error');
            return;
        }

        const btn = document.getElementById('saveUserBtn');
        const spinner = document.getElementById('saveBtnSpinner');
        const btnText = document.getElementById('saveBtnText');
        btn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.textContent = isEditing ? 'Saving...' : 'Creating...';

        try {
            let res;
            if (isEditing) {
                res = await fetch(`/Dashboard/Users/Update/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName, email, institution, userType, privileges })
                });
            } else {
                res = await fetch('/Dashboard/Users/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName, email, institution, userType, privileges })
                });
            }

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || `Failed to ${isEditing ? 'update' : 'create'} user`);

            if (isEditing) {
                const idx = allUsers.findIndex(u => u.id === parseInt(id));
                if (idx >= 0) allUsers[idx] = data;
            } else {
                allUsers.unshift(data);
            }

            renderTable(allUsers);
            closeAddModal();
            showAlert(`User ${isEditing ? 'updated' : 'created'} successfully.`, 'success');
        } catch (err) {
            showModalAlert(err.message || `Failed to ${isEditing ? 'update' : 'create'} user. Please try again.`, 'error');
        } finally {
            btn.disabled = false;
            spinner.classList.add('hidden');
            btnText.textContent = isEditing ? 'Save Changes' : 'Create User';
        }
    }

    // ── Alert helpers ──────────────────────────────────────────────────────
    function showAlert(message, type) {
        const el = document.getElementById('alertArea');
        const isSuccess = type === 'success';
        el.className = `mb-4 px-4 py-3 rounded-xl text-sm border flex items-center gap-2
            ${isSuccess
                ? 'bg-green-50 text-green-700 border-green-200'
                : 'bg-red-50 text-red-700 border-red-200'}`;
        el.innerHTML = `
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                ${isSuccess
                    ? '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>'
                    : '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>'}
            </svg>
            ${escHtml(message)}`;
        el.classList.remove('hidden');
        setTimeout(() => el.classList.add('hidden'), 4000);
    }

    function showModalAlert(message, type) {
        const el = document.getElementById('modalAlert');
        el.className = `mb-1 px-3 py-2 rounded-xl text-xs border
            ${type === 'error' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-green-50 text-green-700 border-green-200'}`;
        el.textContent = message;
        el.classList.remove('hidden');
    }

    // Close modals on backdrop click
    document.getElementById('userModal').addEventListener('click', function(e) {
        if (e.target === this) closeAddModal();
    });
    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeConfirm();
    });

    // Enter key in modal fields
    ['newUserName','newEmail'].forEach(id => {
        document.getElementById(id)?.addEventListener('keydown', e => {
            if (e.key === 'Enter') saveUser();
        });
    });

    // Load on page ready
    loadData();
</script>
}
