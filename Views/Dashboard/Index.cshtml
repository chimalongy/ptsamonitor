@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .fade-up {
        opacity: 0;
        animation: fadeUp 0.45s ease forwards;
    }
    .fade-up-1 { animation-delay: 0.05s; }
    .fade-up-2 { animation-delay: 0.15s; }
    .fade-up-3 { animation-delay: 0.25s; }
</style>

@* ── Welcome ── *@
<div class="mb-8 fade-up fade-up-1">
    <h1 class="text-text-primary text-2xl font-semibold font-display">Welcome to PTSA Monitor</h1>
    <p class="text-text-muted text-sm mt-1">Real-time transaction monitoring and institution management.</p>
</div>

@* ── Stats cards ── *@
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-surface-card border border-border rounded-2xl p-5 fade-up fade-up-1">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                </svg>
            </div>
            <span class="text-text-secondary text-xs font-medium">Transactions Today</span>
        </div>
        <p class="text-text-primary text-2xl font-semibold">—</p>
        <p class="text-text-muted text-xs mt-1">Coming soon</p>
    </div>

    <div class="bg-surface-card border border-border rounded-2xl p-5 fade-up fade-up-2">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 21h18M5 21V7l8-4 8 4v14M9 21v-6h6v6"/>
                </svg>
            </div>
            <span class="text-text-secondary text-xs font-medium">Institutions</span>
        </div>
        <p class="text-text-primary text-2xl font-semibold" id="institutionCount">—</p>
        <p class="text-text-muted text-xs mt-1">Total registered</p>
    </div>

    <div class="bg-surface-card border border-border rounded-2xl p-5 fade-up fade-up-3">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                </svg>
            </div>
            <span class="text-text-secondary text-xs font-medium">Users</span>
        </div>
        <p class="text-text-primary text-2xl font-semibold" id="userCount">—</p>
        <p class="text-text-muted text-xs mt-1">Active system users</p>
    </div>

    <div class="bg-surface-card border border-border rounded-2xl p-5 fade-up fade-up-3">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
            </div>
            <span class="text-text-secondary text-xs font-medium">System Status</span>
        </div>
        <p class="text-green-600 text-2xl font-semibold">Online</p>
        <p class="text-text-muted text-xs mt-1">All systems operational</p>
    </div>
</div>

@* ── Quick links ── *@
<div class="bg-surface-card border border-border rounded-2xl p-6 fade-up fade-up-2">
    <h3 class="text-text-primary text-sm font-semibold mb-4">Quick Actions</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a asp-controller="Dashboard" asp-action="Institutions"
           class="flex items-center gap-3 p-4 border border-border rounded-xl hover:border-brand-300 hover:bg-brand-50 transition-colors group">
            <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center group-hover:bg-brand-200 transition-colors">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 21h18M5 21V7l8-4 8 4v14M9 21v-6h6v6"/>
                </svg>
            </div>
            <div>
                <p class="text-text-primary text-sm font-medium">Manage Institutions</p>
                <p class="text-text-muted text-xs">Add or edit institutions</p>
            </div>
        </a>

        <a asp-controller="Dashboard" asp-action="Users"
           class="flex items-center gap-3 p-4 border border-border rounded-xl hover:border-brand-300 hover:bg-brand-50 transition-colors group">
            <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center group-hover:bg-brand-200 transition-colors">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                </svg>
            </div>
            <div>
                <p class="text-text-primary text-sm font-medium">Manage Users</p>
                <p class="text-text-muted text-xs">Add or edit users</p>
            </div>
        </a>

        <a asp-controller="Dashboard" asp-action="Audit"
           class="flex items-center gap-3 p-4 border border-border rounded-xl hover:border-brand-300 hover:bg-brand-50 transition-colors group">
            <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center group-hover:bg-brand-200 transition-colors">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <div>
                <p class="text-text-primary text-sm font-medium">View Audit Logs</p>
                <p class="text-text-muted text-xs">Track system activity</p>
            </div>
        </a>
    </div>
</div>

@section Scripts {
<script>
    async function loadStats() {
        try {
            const [instRes, userRes] = await Promise.all([
                fetch('/Dashboard/Institutions/GetAll'),
                fetch('/Dashboard/Users/GetAll')
            ]);

            if (instRes.ok) {
                const institutions = await instRes.json();
                document.getElementById('institutionCount').textContent = institutions.length || 0;
            }

            if (userRes.ok) {
                const users = await userRes.json();
                document.getElementById('userCount').textContent = users.length || 0;
            }
        } catch (err) {
            console.error('Failed to load stats:', err);
        }
    }

    loadStats();
</script>
}
